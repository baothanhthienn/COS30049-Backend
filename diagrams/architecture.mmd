graph LR
    Browser["Browser\nReact / Vercel"]

    BodyCap["Body cap\n1 MB"]
    CORS["CORS\nallowlist"]
    Rate["Rate limit\n60 / min"]
    Sem["Semaphore\n10 slots"]

    Classify["POST /api/classify"]
    Chat["POST /api/chat"]
    Sessions["GET /api/sessions"]
    Health["GET /api/health"]

    StageA["RF classifier\n21 features\nALLOW / BLOCK"]
    StageB["K-Means\n6 families\n+ spans"]

    PG[("PostgreSQL")]
    Redis[("Redis\nopt.")]

    Browser -->|"HTTPS\nX-API-Key"| BodyCap
    BodyCap --> CORS --> Rate --> Sem
    Rate -.->|"rate check"| Redis
    Sem --> Classify & Chat & Sessions & Health
    Classify --> StageA
    Chat --> StageA
    StageA --> StageB
    Classify & Chat -->|"store"| PG
    Sessions -->|"read/write"| PG
